  "narrative": {
    "northStar": "The Open Notebook",
    "overview": "Hevanti is designed to sit on a page, not on a screen: cream paper, white sheets with a hairline, a warm rounded Hebrew display face, exactly one solid-green action per screen, and yellow only as the highlighter. It stays quiet because the student is listening to a lecture. The dark theme keeps the same warm paper feeling. Right-to-left Hebrew is the primary direction.",
    "keyCharacteristics": [
      "One solid-green action per screen",
      "Flat by default; one soft shadow for the primary action",
      "Hebrew first and right-to-left",
      "Warm in both themes",
      "One logo at every size"
    ],
    "rules": [
      {
        "name": "The One Green Rule",
        "body": "Only one control per screen is solid green; every other action is a ghost button or a text link.",
        "section": "colors"
      },
      {
        "name": "The Highlighter Rule",
        "body": "Yellow means marked by the student, or the logo check. Never a button or a background.",
        "section": "colors"
      },
      {
        "name": "The Few Headings Rule",
        "body": "Secular One appears only on page titles and the primary card.",
        "section": "typography"
      },
      {
        "name": "The One Lifted Thing Rule",
        "body": "At most one element per screen is lifted by a shadow: the primary action.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep one solid-green action per screen",
      "Do design right-to-left first",
      "Do keep muted text at 4.5:1 on every surface",
      "Do draw icons as 2px line icons",
      "Do show a missing state together with its fix"
    ],
    "donts": [
      "Don't use yellow except for the star and the logo check",
      "Don't nest cards or use thick side borders",
      "Don't use emoji as icons",
      "Don't add a second logo variant",
      "Don't use a cold green-black dark theme"
    ]
